{
    "name": "kematjaya/breadcrumb-bundle",
    "description": "Symfony Breadcrumb Bundle",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/translation": "^7.0|^8.0",
        "twig/twig": "^3.0",
        "doctrine/collections": "^2.2|^3.0",
        "symfony/twig-bundle": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0"
    },
    "conflict": {
        "symfony/framework-bundle": "<7.0",
        "symfony/dependency-injection": "<7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4|^12.0",
        "symfony/browser-kit": "^7.0|^8.0",
        "symfony/phpunit-bridge": "^7.0|^8.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "kematjaya0",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kematjaya\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
